{
  "name": "ai-agents-skills",
  "version": "1.6.2",
  "description": "Modular CLI for distributing 60+ AI agent skills across 11 coding assistants",
  "main": "dist/index.js",
  "bin": {
    "ai-agents-skills": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:logo": "node scripts/generate-logo.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "markdownlint-cli2 \"skills/**/*.md\" \"README.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"skills/**/*.md\" \"README.md\"",
    "format": "biome format --write .",
    "check": "biome check --write . && npm run test && npm run build",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "security": "npm run security:snyk:deps && npm run security:snyk:skills:inspect",
    "security:ci": "npm run security:snyk:deps && npm run security:snyk:skills",
    "security:snyk:deps": "snyk test",
    "security:snyk:skills": "uvx mcp-scan@latest --skills ./skills/",
    "security:snyk:skills:inspect": "uvx mcp-scan@latest inspect --skills ./skills/"
  },
  "keywords": [
    "ai",
    "agents",
    "skills",
    "claude",
    "copilot",
    "cursor",
    "gemini",
    "codex",
    "cli"
  ],
  "author": "Joab Gonzalez <joabgonzalez@gmail.com>",
  "homepage": "https://joabgonzalez.github.io/ai-agents-skills/",
  "repository": {
    "type": "git",
    "url": "https://github.com/joabgonzalez/ai-agents-skills.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "picocolors": "^1.1.1",
    "posthog-node": "^5.21.2",
    "simple-git": "^3.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.1",
    "jest": "^30.2.0",
    "markdownlint-cli2": "^0.21.0",
    "opentype.js": "^1.3.4",
    "snyk": "^1.1303.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
