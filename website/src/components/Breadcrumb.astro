---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const parent = items.length >= 2 ? items[items.length - 2] : null;
---

<!-- Mobile: back link to direct parent -->
{parent && parent.href && (
  <a
    href={parent.href}
    class="flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 sm:hidden"
    aria-label={`Back to ${parent.label}`}
  >
    <span aria-hidden="true">←</span>
    {parent.label}
  </a>
)}

<!-- Desktop: full breadcrumb -->
<nav aria-label="Breadcrumb" class="hidden items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 sm:flex">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true" class="select-none">›</span>}
        {item.href ? (
          <a
            href={item.href}
            class="hover:text-gray-700 hover:underline dark:hover:text-gray-200"
          >
            {item.label}
          </a>
        ) : (
          <span class="font-medium text-gray-700 dark:text-gray-200" aria-current="page">
            {item.label}
          </span>
        )}
      </>
    ))
  }
</nav>
