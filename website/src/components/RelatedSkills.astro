---
interface Props {
  skills: string[];
}

const { skills } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{skills.length > 0 && (
  <div class="mt-4">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">
      See also
    </p>
    <ul class="space-y-1">
      {skills.map((skill) => (
        <li>
          <a
            href={`${base}skills/${skill}/`}
            class="block rounded px-2 py-1 font-mono text-sm text-blue-600 transition-colors hover:bg-blue-50 dark:text-blue-400 dark:hover:bg-blue-900/20"
          >
            {skill}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
