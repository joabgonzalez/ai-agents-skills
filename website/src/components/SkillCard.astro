---
import SkillTypeBadge from './SkillTypeBadge.astro';

interface Props {
  name: string;
  description: string;
  type: string;
  version: string;
  refCount: number;
  href: string;
}

const { name, description, type, version, refCount, href } = Astro.props;

// Strip "Trigger: ..." from description for the excerpt
const excerpt = description.replace(/\s*Trigger:.*$/i, '').trim();
const truncated = excerpt.length > 100 ? `${excerpt.slice(0, 97)}…` : excerpt;
---

<a
  href={href}
  data-type={type}
  class="group flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:border-blue-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900 dark:hover:border-blue-800"
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-mono text-sm font-semibold text-gray-900 group-hover:text-blue-600 dark:text-gray-100 dark:group-hover:text-blue-400">
      {name}
    </h3>
    <SkillTypeBadge {type} class="shrink-0" />
  </div>

  <p class="flex-1 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
    {truncated}
  </p>

  <div class="flex items-center gap-3 text-xs text-gray-400 dark:text-gray-500">
    <span>v{version}</span>
    {refCount > 0 && <span>{refCount} ref{refCount === 1 ? '' : 's'}</span>}
  </div>
</a>
