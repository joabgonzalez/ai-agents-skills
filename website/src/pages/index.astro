---
import { getCollection } from "astro:content";
import IconArrowRight from "../components/icons/IconArrowRight.astro";
import IconCheck from "../components/icons/IconCheck.astro";
import IconCopy from "../components/icons/IconCopy.astro";
import IconSearchOff from "../components/icons/IconSearchOff.astro";
import IconTextAntigravity from "../components/icons/IconTextAntigravity.astro";
import IconTextClaude from "../components/icons/IconTextClaude.astro";
import IconTextClaudeCode from "../components/icons/IconTextClaudeCode.astro";
import IconTextCodex from "../components/icons/IconTextCodex.astro";
import IconTextCopilot from "../components/icons/IconTextCopilot.astro";
import IconTextCursor from "../components/icons/IconTextCursor.astro";
import IconTextGemini from "../components/icons/IconTextGemini.astro";
import IconTextOpenAI from "../components/icons/IconTextOpenAI.astro";
import IconTextOpenCode from "../components/icons/IconTextOpenCode.astro";
import IconTextVSCode from "../components/icons/IconTextVSCode.astro";
import IconToolAntigravity from "../components/icons/IconToolAntigravity.astro";
import IconToolClaude from "../components/icons/IconToolClaude.astro";
import IconToolClaudeCode from "../components/icons/IconToolClaudeCode.astro";
import IconToolCodex from "../components/icons/IconToolCodex.astro";
import IconToolCopilot from "../components/icons/IconToolCopilot.astro";
import IconToolCursor from "../components/icons/IconToolCursor.astro";
import IconToolGemini from "../components/icons/IconToolGemini.astro";
import IconToolOpenAI from "../components/icons/IconToolOpenAI.astro";
import IconToolVSCode from "../components/icons/IconToolVSCode.astro";
import Logo from "../components/icons/Logo.astro";
import SearchBar from "../components/SearchBar.astro";
import SkillCard from "../components/SkillCard.astro";
import TypeFilter from "../components/TypeFilter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const allSkills = await getCollection("skills");
const allRefs = await getCollection("references");

// Build a set of skill names that have references (excluding README)
const skillsWithRefs = new Map<string, number>();
for (const ref of allRefs) {
  const skillName = ref.id.split("/")[0];
  const fileName = ref.id.split("/").pop() ?? "";
  if (fileName !== "README") {
    skillsWithRefs.set(skillName, (skillsWithRefs.get(skillName) ?? 0) + 1);
  }
}

// Extract skill name from collection ID (e.g. "react/SKILL" → "react")
const skills = allSkills
  .map((skill) => ({
    name: skill.data.name,
    description: skill.data.description,
    type: skill.data.metadata.type,
    version: skill.data.metadata.version,
    refCount: skillsWithRefs.get(skill.data.name) ?? 0,
    href: `${base}skills/${skill.data.name}/`,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const total = skills.length;
const installCmd = "npx ai-agents-skills add";
---

<BaseLayout
  title="Agents Skills"
  description={`${total} curated behavioral patterns for AI coding assistants — Claude, Copilot, Cursor, and Codex.`}
>
  <!-- Hero: full-width so bg-grid reaches viewport edges -->
  <div class="relative bg-grid pb-12 pt-10">
    <!-- Radial overlay: fades grid toward content area -->
    <div class="pointer-events-none absolute inset-0 [background:radial-gradient(ellipse_55%_120%_at_10%_50%,white_20%,transparent_100%)] dark:[background:radial-gradient(ellipse_55%_120%_at_10%_50%,#030712_20%,transparent_100%)]" aria-hidden="true"></div>
    <!-- Bottom fade: softens the border-b cut -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-48 bg-linear-to-b from-transparent to-white dark:to-gray-950" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <!-- Wordmark -->
        <div class="mb-8 flex select-none items-center gap-4 sm:gap-6" aria-label="Agents Skills">
          <Logo
            class="animate-hero-logo h-16 w-auto shrink-0 sm:h-20 lg:h-24"
            gradientId="bolt-hero"
          />
          <div
            class="leading-none tracking-widest text-gray-900 dark:text-gray-100"
            style="font-family: 'Exo 2', sans-serif; font-weight: 900;"
          >
            <div class="text-2xl sm:text-3xl lg:text-4xl">AGENTS</div>
            <div class="text-2xl sm:text-3xl lg:text-4xl mt-3 sm:mt-4">
              SKILLS
            </div>
          </div>
        </div>

        <!-- Tagline -->
        <p class="mb-4 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          Curated behavioral patterns for AI coding assistants.
        </p>

        <!-- Tool strip: infinite marquee -->
        <div class="mb-6 flex items-center gap-3">
          <span class="shrink-0 text-xs font-medium tracking-widest uppercase text-gray-400 dark:text-gray-500 select-none">
            Works with
          </span>
          <span class="h-4 w-px shrink-0 bg-gray-200 dark:bg-gray-700" aria-hidden="true"></span>
          <div
            class="overflow-hidden"
            style="mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);"
            aria-label="Claude Code, GitHub Copilot, Codex, Gemini, OpenCode, Cursor, OpenAI, Claude, Visual Studio Code, Google Antigravity"
          >
            <div class="marquee-track" aria-hidden="true">
              <div class="flex items-center gap-4 sm:gap-6 pr-4 sm:pr-6">
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolClaudeCode class="h-5 w-5 shrink-0" />
                  <IconTextClaudeCode class="hidden sm:block h-4 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolCopilot class="h-4 w-4 shrink-0" />
                  <IconTextCopilot class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolCodex class="h-4 w-4 shrink-0" />
                  <IconTextCodex class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolGemini class="h-4 w-4 shrink-0" />
                  <IconTextGemini class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="hidden sm:flex items-center text-gray-400 dark:text-gray-500">
                  <IconTextOpenCode class="h-4 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolCursor class="h-4 w-4 shrink-0" />
                  <IconTextCursor class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolOpenAI class="h-4 w-4 shrink-0" />
                  <IconTextOpenAI class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolClaude class="h-4 w-4 shrink-0" />
                  <IconTextClaude class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolVSCode class="h-4 w-4 shrink-0" />
                  <IconTextVSCode class="hidden sm:inline-block" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolAntigravity class="h-4 w-4 shrink-0" />
                  <IconTextAntigravity class="hidden sm:block h-3.5 w-auto" />
                </div>
              </div>
              <!-- Duplicate set for seamless loop -->
              <div class="flex items-center gap-4 sm:gap-6 pr-4 sm:pr-6" aria-hidden="true">
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolClaudeCode class="h-5 w-5 shrink-0" />
                  <IconTextClaudeCode class="hidden sm:block h-4 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolCopilot class="h-4 w-4 shrink-0" />
                  <IconTextCopilot class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolCodex class="h-4 w-4 shrink-0" />
                  <IconTextCodex class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolGemini class="h-4 w-4 shrink-0" />
                  <IconTextGemini class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="hidden sm:flex items-center text-gray-400 dark:text-gray-500">
                  <IconTextOpenCode class="h-4 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolCursor class="h-4 w-4 shrink-0" />
                  <IconTextCursor class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolOpenAI class="h-4 w-4 shrink-0" />
                  <IconTextOpenAI class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolClaude class="h-4 w-4 shrink-0" />
                  <IconTextClaude class="hidden sm:block h-3 w-auto" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolVSCode class="h-4 w-4 shrink-0" />
                  <IconTextVSCode class="hidden sm:inline-block" />
                </div>
                <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500">
                  <IconToolAntigravity class="h-4 w-4 shrink-0" />
                  <IconTextAntigravity class="hidden sm:block h-3.5 w-auto" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Install command -->
        <p class="mb-2 text-xs font-medium tracking-widest uppercase text-gray-400 dark:text-gray-500 select-none">
          Quick start
        </p>
        <div
          class="flex items-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-800 dark:bg-gray-900"
        >
          <span
            class="font-mono text-sm text-gray-400 dark:text-gray-600 select-none"
            >$</span
          >
          <code
            class="flex-1 font-mono text-sm text-gray-800 dark:text-gray-200"
            id="hero-cmd"
          >
            {installCmd}
          </code>
          <button
            id="hero-copy-btn"
            data-cmd={installCmd}
            class="shrink-0 rounded-md p-1.5 text-gray-500 transition-colors hover:bg-gray-200 hover:text-gray-700 dark:hover:bg-gray-700 dark:hover:text-gray-300"
            aria-label="Copy install command"
          >
            <span id="hero-copy-icon"><IconCopy /></span>
            <span id="hero-check-icon" class="hidden text-green-500"
              ><IconCheck /></span
            >
          </button>
        </div>

        <!-- Stats + CTA -->
        <div
          class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 dark:text-gray-400"
        >
          <span>{total} skills</span>
          <span aria-hidden="true">·</span>
          <span>7 types</span>
          <span aria-hidden="true">·</span>
          <a
            href={`${base}getting-started/`}
            class="text-blue-600 hover:underline dark:text-blue-400"
          >
            Getting Started <IconArrowRight class="inline h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Catalog -->
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Search -->
    <div class="mb-6">
      <SearchBar />
    </div>

    <!-- Filter + grid -->
    <div class="mb-6">
      <TypeFilter types={[]} {total} />
    </div>

    <div
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
      id="skills-grid"
    >
      {skills.map((skill) => <SkillCard {...skill} />)}
    </div>

    <!-- Empty state -->
    <div id="skills-empty" class="hidden py-20 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800">
        <IconSearchOff class="h-6 w-6 text-gray-400 dark:text-gray-500" />
      </div>
      <p class="text-lg font-medium text-gray-900 dark:text-gray-100">No skills found</p>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Try a different search term or clear the type filter.</p>
    </div>
  </div>
</BaseLayout>


<script>
  const btn = document.getElementById("hero-copy-btn");
  const copyIcon = document.getElementById("hero-copy-icon");
  const checkIcon = document.getElementById("hero-check-icon");
  if (btn && copyIcon && checkIcon) {
    btn.addEventListener("click", async () => {
      const cmd = (btn as HTMLButtonElement).dataset.cmd;
      if (!cmd) return;
      await navigator.clipboard.writeText(cmd);
      copyIcon.classList.add("hidden");
      checkIcon.classList.remove("hidden");
      setTimeout(() => {
        checkIcon.classList.add("hidden");
        copyIcon.classList.remove("hidden");
      }, 1500);
    });
  }
</script>
