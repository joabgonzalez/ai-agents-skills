---
import { getCollection, render } from 'astro:content';
import ReferenceSidebar from '../../../../components/ReferenceSidebar.astro';
import TableOfContents from '../../../../components/TableOfContents.astro';
import SkillLayout from '../../../../layouts/SkillLayout.astro';

export async function getStaticPaths() {
  const allRefs = await getCollection('references');

  // Collect unique skill names that have a README reference
  const skillsWithRefs = new Set(
    allRefs
      .filter((r) => r.id.split('/').pop()?.toLowerCase() === 'readme')
      .map((r) => r.id.split('/')[0])
  );

  return [...skillsWithRefs].map((name) => ({
    params: { name },
  }));
}

const { name } = Astro.params;
const base = import.meta.env.BASE_URL;

const allRefs = await getCollection('references');

const readmeEntry = allRefs.find(
  (r) => r.id.split('/')[0] === name && r.id.split('/').pop()?.toLowerCase() === 'readme'
);

const extractH1 = (body: string, fallback: string) =>
  body.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? fallback;

const formatSlug = (slug: string) =>
  slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const nonReadmeRefs = allRefs
  .filter((r) => {
    const skillName = r.id.split('/')[0];
    const fileName = r.id.split('/').pop()?.toLowerCase() ?? '';
    return skillName === name && fileName !== 'readme';
  })
  .map((r) => {
    const slug = r.id.split('/').pop() ?? '';
    return { slug, title: extractH1(r.body ?? '', formatSlug(slug)) };
  });

const { Content, headings } = readmeEntry ? await render(readmeEntry) : { Content: null, headings: [] };
---

<SkillLayout
  title={`References — ${name} — AI Agent Skills`}
  description={`Reference files for the ${name} skill.`}
  breadcrumbs={[
    { label: 'Home', href: base },
    { label: 'Skills', href: base },
    { label: name.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '), href: `${base}skills/${name}/` },
    { label: 'References' },
  ]}
>
  <!-- Main content: README.md -->
  <article slot="content" class="prose prose-gray max-w-none dark:prose-invert">
    {Content ? <Content /> : <p>No overview available.</p>}
  </article>

  <!-- Sidebar -->
  <div slot="sidebar" class="flex flex-col gap-1">
    <ReferenceSidebar skillName={name} refs={nonReadmeRefs} />
    <TableOfContents {headings} />
  </div>
</SkillLayout>
