---
import { getCollection, render } from 'astro:content';
import SkillMeta from '../../../components/SkillMeta.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import SkillLayout from '../../../layouts/SkillLayout.astro';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map((skill) => {
    const name = skill.id.split('/')[0]; // "react/SKILL" → "react"
    return {
      params: { name },
      props: { skill },
    };
  });
}

const { skill } = Astro.props;
const { name } = Astro.params;
const base = import.meta.env.BASE_URL;

const { Content, headings } = await render(skill);
const { description, metadata } = skill.data;
const { type, version, skills: relatedSkills = [] } = metadata;

// Check if this skill has references
const allRefs = await getCollection('references');

const extractH1 = (body: string, fallback: string) =>
  body.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? fallback;

const formatSlug = (slug: string) =>
  slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const myRefs = allRefs
  .filter((r) => {
    const skillName = r.id.split('/')[0];
    const fileName = r.id.split('/').pop() ?? '';
    return skillName === name && fileName.toLowerCase() !== 'readme';
  })
  .map((r) => {
    const slug = r.id.split('/').pop() ?? '';
    return { slug, title: extractH1(r.body ?? '', formatSlug(slug)) };
  });
const hasReferences = myRefs.length > 0;

// Clean description for meta
const metaDesc = description.replace(/\s*Trigger:.*$/i, '').trim();
---

<SkillLayout
  title={`${name} — AI Agent Skills`}
  description={metaDesc}
  breadcrumbs={[
    { label: 'Home', href: base },
    { label: 'Skills', href: base },
    { label: name.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') },
  ]}
>
  <!-- Main content -->
  <article slot="content" class="prose prose-gray max-w-none dark:prose-invert">
    <Content />
  </article>

  <!-- Meta card (above content on mobile, top of sidebar on desktop) -->
  <div slot="meta">
    <SkillMeta
      {name}
      {type}
      {version}
      relatedSkills={relatedSkills}
    />
  </div>

  <!-- Sidebar -->
  <div slot="sidebar" class="flex flex-col gap-1">

    <TableOfContents {headings} />

    {hasReferences && (
      <div class="mt-4 flex flex-col gap-1">
        <p class="mb-1 px-2.5 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">
          References
        </p>
        <a
          href={`${base}skills/${name}/references/`}
          class="rounded-md px-2.5 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100"
        >
          Overview
        </a>
        {myRefs.map(({ slug, title }) => (
          <a
            href={`${base}skills/${name}/references/${slug}/`}
            class="rounded-md px-2.5 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100"
          >
            {title}
          </a>
        ))}
      </div>
    )}
  </div>
</SkillLayout>
