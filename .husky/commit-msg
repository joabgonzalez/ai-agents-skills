MESSAGE=$(head -n1 "$1")

case "$MESSAGE" in
  release\(*)
    case "$MESSAGE" in
      "release(patch): "*|"release(minor): "*|"release(major): "*)
        ;;
      *)
        echo "Invalid release commit message: \"$MESSAGE\""
        echo "Expected format: release(patch|minor|major): summary"
        exit 1
        ;;
    esac
    ;;
esac
